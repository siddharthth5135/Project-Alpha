# Project Alpha - environment template
# Copy to .env and fill locally. NEVER commit .env.
# NEVER paste API keys, MPINs, or TOTP secrets into chat or GitHub.

# ---------------------------------------------------------------------------
# EXECUTION MODE
#   backtest | paper | live
# live is refused by code unless ALPHA_LIVE_GO_SIGNATURE is also set.
# ---------------------------------------------------------------------------
ALPHA_MODE=paper

# HoQR written GO for live capital. Leave EMPTY until Gate G5 is signed.
# Format: "GO-LIVE <YYYY-MM-DD> <HoQR name>"
ALPHA_LIVE_GO_SIGNATURE=

# ---------------------------------------------------------------------------
# PATHS (keep data off C:)
# ---------------------------------------------------------------------------
ALPHA_DATA_ROOT=D:/Project Alpha/alpha-desk/data
ALPHA_ARTIFACT_ROOT=D:/Project Alpha/alpha-desk/artifacts
ALPHA_LOG_ROOT=D:/Project Alpha/alpha-desk/logs

# ---------------------------------------------------------------------------
# MARKET DATA SoR — Angel One SmartAPI (TrueData trial ended)
# Market-data network stays OFF until you set ALLOW=true AND approve a session.
# This flag does NOT enable order placement (still Gate G5).
# ---------------------------------------------------------------------------
MARKET_DATA_PROVIDER=angelone
ANGELONE_ALLOW_MARKETDATA=true

# API_KEY + CLIENT_CODE: from https://smartapi.angelone.in (create app → copy key; client = Angel login id)
# MPIN: the 4-digit PIN you set for Angel One app / web login (same PIN you type to log in)
# TOTP_SECRET: SmartAPI portal → enable TOTP for the app → copy the BASE32 secret (not the 6-digit codes)
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=

# Optional overrides
# ANGELONE_BASE_URL=https://apiconnect.angelone.in
# ANGELONE_MAX_LIVE_SYMBOLS=50
# ANGELONE_POLL_INTERVAL_S=1
# ANGELONE_REST_RPM=60
ANGELONE_HISTORY_DAYS_M1=30
ANGELONE_HISTORY_DAYS_M5=100
ANGELONE_HISTORY_DAYS_M15=200
ANGELONE_HISTORY_DAYS_M30=200
ANGELONE_HISTORY_DAYS_M60=400
ANGELONE_HISTORY_DAYS_EOD=2000
# ANGELONE_SEGMENTS=INDEX,EQ,FUT,OPT,CDS,COM

# ---------------------------------------------------------------------------
# ALERTS + daily Telegram report (optional)
# 1) Talk to @BotFather -> /newbot -> copy token -> TELEGRAM_BOT_TOKEN
# 2) Private: message your bot, then get chat id (e.g. @userinfobot) -> TELEGRAM_CHAT_ID
# 3) Group: add bot to group, make it able to post, put group id (often -100…) in
#    TELEGRAM_CHAT_ID or list several in TELEGRAM_CHAT_IDS=id1,id2
# After all daily jobs (~16:50 IST) AlphaDesk-Report sends the day summary there.
# Failures also ping immediately (beep + toast + Telegram).
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_CHAT_IDS=-1001234567890,-1009876543210

# ---------------------------------------------------------------------------
# TrueData — LEGACY (trial over; leave blank / unused)
# Kept only so old scripts still parse env if you re-enable temporarily.
# ---------------------------------------------------------------------------
TRUEDATA_USER=
TRUEDATA_PASSWORD=
TRUEDATA_AUTH_URL=https://auth.truedata.in/token
TRUEDATA_HISTORY_URL=https://history.truedata.in
TRUEDATA_ANALYTICS_URL=https://analytics.truedata.in
TRUEDATA_GREEKS_URL=https://greeks.truedata.in
TRUEDATA_WS_HOST=wss://push.truedata.in
TRUEDATA_WS_PORT=8082
TRUEDATA_MAX_LIVE_SYMBOLS=30
TRUEDATA_REST_RPM=300
TRUEDATA_HISTORY_DAYS_M1=60
TRUEDATA_HISTORY_DAYS_M15=60
TRUEDATA_HISTORY_DAYS_EOD=7300
TRUEDATA_SANDBOX=false
