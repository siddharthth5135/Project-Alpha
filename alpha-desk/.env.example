# Project Alpha - environment template
# Copy to .env and fill locally. NEVER commit .env.

# ---------------------------------------------------------------------------
# EXECUTION MODE
#   backtest | paper | live
# live is refused by code unless ALPHA_LIVE_GO_SIGNATURE is also set.
# ---------------------------------------------------------------------------
ALPHA_MODE=paper

# HoQR written GO for live capital. Leave EMPTY until Gate G5 is signed.
# Format: "GO-LIVE <YYYY-MM-DD> <HoQR name>"
ALPHA_LIVE_GO_SIGNATURE=

# ---------------------------------------------------------------------------
# PATHS (keep data off C:)
# ---------------------------------------------------------------------------
ALPHA_DATA_ROOT=D:/Project Alpha/alpha-desk/data
ALPHA_ARTIFACT_ROOT=D:/Project Alpha/alpha-desk/artifacts
ALPHA_LOG_ROOT=D:/Project Alpha/alpha-desk/logs

# ---------------------------------------------------------------------------
# BROKER - Angel One SmartAPI (leave blank until HoQR shares them)
# ---------------------------------------------------------------------------
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=

# ---------------------------------------------------------------------------
# ALERTS (optional)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# TrueData Market Data API
# Velocity desktop logins are NOT the same as API credentials.
# Leave blank until Market Data API (not Velocity) is enabled.
# ---------------------------------------------------------------------------
TRUEDATA_USER=
TRUEDATA_PASSWORD=

# Hosts (TLS only; defaults match production). Override only if TrueData
# assigns a different history/analytics/greeks host or a sandbox.
TRUEDATA_AUTH_URL=https://auth.truedata.in/token
TRUEDATA_HISTORY_URL=https://history.truedata.in
# Alias still accepted: TRUEDATA_HIST_URL
TRUEDATA_ANALYTICS_URL=https://analytics.truedata.in
TRUEDATA_GREEKS_URL=https://greeks.truedata.in
TRUEDATA_WS_HOST=wss://push.truedata.in
# Websocket port is assigned PER ACCOUNT. Confirm with TrueData on enablement.
TRUEDATA_WS_PORT=8082

# Plan limits — set these to match what TrueData quotes for YOUR account.
# Typical 7-day trial (verify with support; do not assume):
#   30 concurrent live symbols | 5 REST req/s (~300/min) | 2 days tick history
#   ~2 months 1-minute history | 7 calendar days then keys revoke
TRUEDATA_MAX_LIVE_SYMBOLS=30
TRUEDATA_REST_RPM=300
TRUEDATA_TIMEOUT_S=15
TRUEDATA_MAX_RETRIES=4
TRUEDATA_HEARTBEAT_TIMEOUT_S=20
TRUEDATA_SEGMENTS=INDEX,EQ,FUT,OPT
TRUEDATA_ENTITLED_GREEKS=true
TRUEDATA_ENTITLED_TICKS=true
# Rolling history depth the PLAN covers (days). Adapter refuses older windows.
TRUEDATA_HISTORY_DAYS_M1=60
TRUEDATA_HISTORY_DAYS_M15=60
TRUEDATA_HISTORY_DAYS_EOD=7300
TRUEDATA_HISTORY_DAYS_TICK=2

# Optional: append raw websocket frames (JSONL) for protocol confirmation.
# TRUEDATA_RAW_CAPTURE_DIR=D:/Project Alpha/alpha-desk/logs/truedata_raw
TRUEDATA_SANDBOX=false
