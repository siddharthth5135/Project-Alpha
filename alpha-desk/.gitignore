# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# --- data & artifacts (live on D:, not in git) ---
# Anchored to alpha-desk package root so src/alpha_desk/data|audit stay trackable.
/data/
/artifacts/
/logs/
/audit/
*.parquet
*.duckdb
*.sqlite
*.sqlite3
*.db
_tmp_*/

# --- vendor NDA / local API extracts ---
TD_API_Documents.zip
_td_docs_extract/

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# --- os / editor ---
Thumbs.db
.DS_Store
.idea/

# Whitelist source packages
!src/alpha_desk/data/
!src/alpha_desk/data/**
!src/alpha_desk/audit/
!src/alpha_desk/audit/**
!alpha-desk/src/alpha_desk/data/**
!alpha-desk/src/alpha_desk/audit/**
