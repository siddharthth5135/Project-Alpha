# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# --- market data & runtime (repo-root / alpha-desk runtime only) ---
# Anchored so src/alpha_desk/data and src/alpha_desk/audit stay trackable.
/data/
/artifacts/
/logs/
/audit/
alpha-desk/data/
alpha-desk/artifacts/
alpha-desk/logs/
alpha-desk/audit/
*.parquet
*.duckdb
*.sqlite
*.sqlite3
*.db
_tmp_*/
_tmp_backfill/

# --- vendor NDA / local API extracts ---
TD_API_Documents.zip
_td_docs_extract/
/**/_td_docs_extract/

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.dist/

# --- os / editor ---
Thumbs.db
.DS_Store
.idea/
.vscode/
*.swp

# Whitelist source packages (never treat these as runtime dirs)
!alpha-desk/src/alpha_desk/data/
!alpha-desk/src/alpha_desk/data/**
!alpha-desk/src/alpha_desk/audit/
!alpha-desk/src/alpha_desk/audit/**

# Re-ignore bytecode under whitelisted trees
alpha-desk/src/alpha_desk/data/**/__pycache__/
alpha-desk/src/alpha_desk/audit/**/__pycache__/
